@model SmartSpend.ViewModels.TransactionViewModel

@{
    ViewBag.Title = "Add Transaction";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.HideSidebar = false;
}

<style>
    .form-main {
        padding: 36px 40px;
    }

    .page-header {
        margin-bottom: 32px;
    }

        .page-header h1 {
            font-size: 28px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .page-header p {
            font-size: 14px;
            color: rgba(255,255,255,0.45);
            margin-top: 6px;
        }

    .form-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 20px;
        padding: 36px;
        max-width: 660px;
    }

    /* Type toggle */
    .type-toggle {
        display: flex;
        gap: 12px;
        margin-bottom: 28px;
    }

    .type-btn {
        flex: 1;
        padding: 16px;
        border-radius: 14px;
        border: 2px solid rgba(255,255,255,0.1);
        background: transparent;
        color: rgba(255,255,255,0.4);
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

        .type-btn.income.selected {
            border-color: #10b981;
            background: rgba(16,185,129,0.1);
            color: #10b981;
        }

        .type-btn.expense.selected {
            border-color: #f87171;
            background: rgba(248,113,113,0.1);
            color: #f87171;
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: rgba(255,255,255,0.5);
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px;
        color: #ffffff;
        font-size: 15px;
        font-family: inherit;
        transition: all 0.2s;
        outline: none;
    }

        .form-control::placeholder {
            color: rgba(255,255,255,0.25);
        }

        .form-control:focus {
            border-color: #6366f1;
            background: rgba(99,102,241,0.08);
            box-shadow: 0 0 0 3px rgba(99,102,241,0.12);
        }

        .form-control option {
            background: #1a1a2e;
        }

    .checkbox-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .checkbox-row:hover {
            background: rgba(255,255,255,0.06);
        }

        .checkbox-row input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #6366f1;
            cursor: pointer;
        }

        .checkbox-row label {
            text-transform: none;
            letter-spacing: 0;
            font-size: 14px;
            color: rgba(255,255,255,0.65);
            margin-bottom: 0;
            cursor: pointer;
            font-weight: 500;
        }

    .recurring-box {
        display: none;
        margin-top: 12px;
        padding: 16px;
        background: rgba(99,102,241,0.06);
        border: 1px solid rgba(99,102,241,0.2);
        border-radius: 10px;
    }

    .text-danger {
        color: #f87171;
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
    }

    .btn-submit {
        flex: 1;
        padding: 14px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s;
        box-shadow: 0 4px 15px rgba(99,102,241,0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-submit:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

    .btn-cancel {
        padding: 14px 28px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.5);
        border-radius: 12px;
        font-size: 15px;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-cancel:hover {
            background: rgba(255,255,255,0.08);
            color: #fff;
            text-decoration: none;
        }

    @@media (max-width: 768px) {
        .form-main {
            padding: 20px 16px;
        }

        .form-card {
            padding: 24px;
        }

        .form-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="form-main">
    <div class="page-header">
        <h1>
            <i class="fas fa-plus-circle" style="color:#6366f1;"></i>
            Add Transaction
        </h1>
        <p>Record a new income or expense</p>
    </div>

    <div class="form-card">
        @using (Html.BeginForm("Add", "Transaction", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(m => m.Type, new { id = "hiddenType" })

            <!-- Type Toggle -->
            <div class="type-toggle">
                <button type="button" class="type-btn income" id="btnIncome"
                        onclick="selectType('Income')">
                    <i class="fas fa-arrow-trend-up"></i> Income
                </button>
                <button type="button" class="type-btn expense" id="btnExpense"
                        onclick="selectType('Expense')">
                    <i class="fas fa-arrow-trend-down"></i> Expense
                </button>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label><i class="fas fa-coins"></i> Amount (R)</label>
                    @Html.TextBoxFor(m => m.Amount, new
                    {
                        @class = "form-control",
                        placeholder = "0.00",
                        type = "number",
                        step = "0.01",
                        min = "0.01"
                    })
                    @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <label><i class="fas fa-tags"></i> Category</label>
                    @Html.DropDownListFor(m => m.CategoryId, Model.Categories,
                             "-- Select Category --", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <label><i class="fas fa-align-left"></i> Description</label>
                @Html.TextBoxFor(m => m.Description, new
                {
                    @class = "form-control",
                    placeholder = "What was this for? (optional)"
                })
            </div>

            <div class="form-group">
                <label><i class="fas fa-calendar-day"></i> Date</label>
                @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-dd}", new
                {
                    @class = "form-control",
                    type = "date"
                })
                @Html.ValidationMessageFor(m => m.Date, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <div class="checkbox-row" onclick="document.getElementById('isRecurring').click()">
                    @Html.CheckBoxFor(m => m.IsRecurring, new
                    {
                        id = "isRecurring",
                        onchange = "toggleRecurring(this)",
                        onclick = "event.stopPropagation()"
                    })
                    <label>
                        <i class="fas fa-sync-alt" style="color:#a5b4fc;"></i>
                        This is a recurring transaction
                    </label>
                </div>

                <div class="recurring-box" id="recurringBox">
                    <div class="form-group" style="margin-bottom:0;">
                        <label><i class="fas fa-clock"></i> Frequency</label>
                        @Html.DropDownListFor(m => m.Frequency,
                                 new SelectList(new[] { "Monthly", "Weekly" }),
                                 "-- Select Frequency --",
                                 new { @class = "form-control" })
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-submit">
                    <i class="fas fa-save"></i> Save Transaction
                </button>
                <a href="/Transaction/Index" class="btn-cancel">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        function selectType(type) {
            document.getElementById('hiddenType').value = type;
            document.getElementById('btnIncome').classList.toggle('selected', type === 'Income');
            document.getElementById('btnExpense').classList.toggle('selected', type === 'Expense');
        }

        function toggleRecurring(cb) {
            document.getElementById('recurringBox').style.display = cb.checked ? 'block' : 'none';
        }

        // Default to Expense
        selectType('Expense');
    </script>
}