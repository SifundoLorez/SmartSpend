@model IEnumerable<SmartSpend.Models.Transaction>

@{
    ViewBag.Title = "Transactions";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.HideSidebar = false;
}

<style>
    .transactions-main {
        padding: 36px 40px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        flex-wrap: wrap;
        gap: 16px;
    }

        .page-header h1 {
            font-size: 28px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .page-header p {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.45);
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .btn-add {
        padding: 12px 24px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff;
        text-decoration: none;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s ease;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.25);
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-add:hover {
            opacity: 0.9;
            transform: translateY(-2px);
            color: #fff;
            text-decoration: none;
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.35);
        }

    /* Summary bar */
    .summary-bar {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-bottom: 32px;
    }

    .summary-pill {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 20px;
        padding: 20px 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: all 0.3s ease;
    }

        .summary-pill:hover {
            background: rgba(255, 255, 255, 0.06);
            transform: translateY(-2px);
            border-color: rgba(99, 102, 241, 0.2);
        }

    .pill-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

        .pill-icon.income {
            background: rgba(16, 185, 129, 0.12);
        }

        .pill-icon.expense {
            background: rgba(248, 113, 113, 0.12);
        }

        .pill-icon.balance {
            background: rgba(99, 102, 241, 0.12);
        }

    .pill-label {
        font-size: 12px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.5);
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .pill-amount {
        font-size: 24px;
        font-weight: 800;
    }

        .pill-amount.income {
            color: #10b981;
        }

        .pill-amount.expense {
            color: #f87171;
        }

        .pill-amount.balance {
            color: #6366f1;
        }

    /* Filters */
    .filters-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 20px;
        padding: 24px;
        margin-bottom: 32px;
    }

    .filters-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr 1fr auto;
        gap: 16px;
        align-items: end;
    }

    .filter-group label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.5);
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

        .filter-group label i {
            margin-right: 6px;
        }

    .filter-control {
        width: 100%;
        padding: 12px 14px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        color: #ffffff;
        font-size: 14px;
        font-family: inherit;
        outline: none;
        transition: all 0.2s ease;
    }

        .filter-control:focus {
            border-color: #6366f1;
            background: rgba(99, 102, 241, 0.08);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

        .filter-control option {
            background: #1a1a2e;
        }

        .filter-control::placeholder {
            color: rgba(255, 255, 255, 0.25);
        }

    .btn-filter {
        padding: 12px 24px;
        background: rgba(99, 102, 241, 0.2);
        border: 1px solid rgba(99, 102, 241, 0.35);
        color: #a5b4fc;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s ease;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-filter:hover {
            background: rgba(99, 102, 241, 0.35);
            color: #fff;
            transform: translateY(-1px);
        }

    .btn-clear {
        padding: 12px 20px;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.5);
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

        .btn-clear:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            text-decoration: none;
            transform: translateY(-1px);
        }

    /* Table */
    .table-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 20px;
        overflow: hidden;
    }

    .table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        background: rgba(255, 255, 255, 0.02);
    }

        .table-toolbar span {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.5);
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .table-head {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr 130px;
        padding: 14px 24px;
        background: rgba(255, 255, 255, 0.03);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: rgba(255, 255, 255, 0.45);
    }

        .table-head i {
            margin-right: 6px;
            font-size: 11px;
        }

    .table-row {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr 130px;
        padding: 16px 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        align-items: center;
        transition: background 0.2s ease;
    }

        .table-row:last-child {
            border-bottom: none;
        }

        .table-row:hover {
            background: rgba(255, 255, 255, 0.04);
        }

    .t-desc {
        font-size: 14px;
        font-weight: 500;
        color: #fff;
    }

    .t-date {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.4);
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .t-recur {
        font-size: 11px;
        color: #a5b4fc;
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .cat-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 12px;
        border-radius: 100px;
        font-size: 12px;
        font-weight: 500;
        background: rgba(99, 102, 241, 0.12);
        color: #a5b4fc;
        width: fit-content;
    }

    .type-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 100px;
        font-size: 11px;
        font-weight: 600;
        width: fit-content;
    }

    .type-income {
        background: rgba(16, 185, 129, 0.12);
        color: #34d399;
    }

    .type-expense {
        background: rgba(248, 113, 113, 0.12);
        color: #f87171;
    }

    .t-amount {
        font-size: 15px;
        font-weight: 700;
    }

    .amt-income {
        color: #10b981;
    }

    .amt-expense {
        color: #f87171;
    }

    .t-actions {
        display: flex;
        gap: 10px;
    }

    .btn-edit-sm {
        padding: 7px 14px;
        border-radius: 8px;
        background: rgba(99, 102, 241, 0.12);
        color: #a5b4fc;
        text-decoration: none;
        font-size: 12px;
        font-weight: 500;
        border: 1px solid rgba(99, 102, 241, 0.2);
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-edit-sm:hover {
            background: rgba(99, 102, 241, 0.25);
            color: #fff;
            text-decoration: none;
            transform: translateY(-1px);
        }

    .btn-del-sm {
        padding: 7px 14px;
        border-radius: 8px;
        background: rgba(248, 113, 113, 0.1);
        color: #f87171;
        font-size: 12px;
        font-weight: 500;
        border: 1px solid rgba(248, 113, 113, 0.2);
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-del-sm:hover {
            background: rgba(248, 113, 113, 0.2);
            transform: translateY(-1px);
        }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: rgba(255, 255, 255, 0.35);
    }

        .empty-state i {
            font-size: 56px;
            margin-bottom: 16px;
            display: block;
            opacity: 0.5;
        }

        .empty-state p {
            font-size: 16px;
            margin-bottom: 8px;
        }

        .empty-state small {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.25);
        }

    /* Responsive */
    @@media (max-width: 1100px) {
        .transactions-main {
            padding: 24px;
        }

        .filters-grid {
            grid-template-columns: 1fr 1fr 1fr;
        }

        .table-head, .table-row {
            grid-template-columns: 2fr 1fr 1fr 100px;
        }

            .table-head span:nth-child(3),
            .table-row > div:nth-child(3) {
                display: none;
            }
    }

    @@media (max-width: 768px) {
        .transactions-main {
            padding: 20px 16px;
        }

        .summary-bar {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .filters-grid {
            grid-template-columns: 1fr;
        }

        .table-head, .table-row {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .table-head {
            display: none;
        }

        .table-row {
            padding: 16px;
        }

        .t-actions {
            justify-content: flex-start;
        }
    }
</style>

<div class="transactions-main">
    <div class="page-header">
        <div>
            <h1>
                <i class="fas fa-list-ul" style="color: #6366f1;"></i>
                Transactions
            </h1>
            <p>
                <i class="fas fa-chart-line"></i>
                Manage all your income and expenses
            </p>
        </div>
        <a href="/Transaction/Add" class="btn-add">
            <i class="fas fa-plus-circle"></i> Add Transaction
        </a>
    </div>

    <!-- Summary Bar -->
    @{
        decimal totalIncome = Model.Where(t => t.Type == "Income").Sum(t => t.Amount);
        decimal totalExpenses = Model.Where(t => t.Type == "Expense").Sum(t => t.Amount);
        decimal balance = totalIncome - totalExpenses;
    }

    <div class="summary-bar">
        <div class="summary-pill">
            <div class="pill-icon income">
                <i class="fas fa-arrow-trend-up"></i>
            </div>
            <div>
                <div class="pill-label">Total Income</div>
                <div class="pill-amount income">R @totalIncome.ToString("N2")</div>
            </div>
        </div>
        <div class="summary-pill">
            <div class="pill-icon expense">
                <i class="fas fa-arrow-trend-down"></i>
            </div>
            <div>
                <div class="pill-label">Total Expenses</div>
                <div class="pill-amount expense">R @totalExpenses.ToString("N2")</div>
            </div>
        </div>
        <div class="summary-pill">
            <div class="pill-icon balance">
                <i class="fas fa-wallet"></i>
            </div>
            <div>
                <div class="pill-label">Net Balance</div>
                <div class="pill-amount balance">R @balance.ToString("N2")</div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filters-card">
        @using (Html.BeginForm("Index", "Transaction", FormMethod.Get))
        {
            <div class="filters-grid">
                <div class="filter-group">
                    <label><i class="fas fa-search"></i> Search</label>
                    <input name="search" value="@ViewBag.Search"
                           class="filter-control" placeholder="Search description..." />
                </div>
                <div class="filter-group">
                    <label><i class="fas fa-chart-simple"></i> Type</label>
                    <select name="type" class="filter-control">
                        <option value="">All Types</option>
                        <option value="Income" @(ViewBag.SelectedType == "Income" ? "selected" : "")>
                            Income
                        </option>
                        <option value="Expense" @(ViewBag.SelectedType == "Expense" ? "selected" : "")>
                            Expense
                        </option>
                    </select>
                </div>
                <div class="filter-group">
                    <label><i class="fas fa-tags"></i> Category</label>
                    <select name="categoryId" class="filter-control">
                        <option value="">All Categories</option>
                        @foreach (var cat in (System.Collections.Generic.List<SmartSpend.Models.Category>)ViewBag.Categories)
                        {
                            <option value="@cat.Id"
                                    @(ViewBag.SelectedCategory != null && (int)ViewBag.SelectedCategory == cat.Id ? "selected" : "")>
                                @cat.Icon @cat.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="filter-group">
                    <label><i class="fas fa-calendar-alt"></i> From</label>
                    <input type="date" name="from" value="@ViewBag.From" class="filter-control" />
                </div>
                <div class="filter-group">
                    <label><i class="fas fa-calendar-alt"></i> To</label>
                    <input type="date" name="to" value="@ViewBag.To" class="filter-control" />
                </div>
                <div class="filter-group" style="display: flex; gap: 8px;">
                    <div>
                        <label>&nbsp;</label>
                        <button type="submit" class="btn-filter">
                            <i class="fas fa-sliders-h"></i> Filter
                        </button>
                    </div>
                    <div>
                        <label>&nbsp;</label>
                        <a href="/Transaction/Index" class="btn-clear">
                            <i class="fas fa-times"></i> Clear
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Table -->
    <div class="table-card">
        <div class="table-toolbar">
            <span>
                <i class="fas fa-database"></i>
                @Model.Count() transaction@(Model.Count() == 1 ? "" : "s") found
            </span>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string) ||
                 !string.IsNullOrEmpty(ViewBag.SelectedType as string) ||
                 (ViewBag.SelectedCategory != null && (int)ViewBag.SelectedCategory > 0))
            {
                <span style="color: #a5b4fc; font-size: 13px;">
                    <i class="fas fa-filter"></i> Filters active
                </span>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-receipt"></i>
                <p>No transactions found</p>
                <small>Try adjusting your filters or add a new transaction</small>
            </div>
        }
        else
        {
            <div class="table-head">
                <span><i class="fas fa-align-left"></i> Description</span>
                <span><i class="fas fa-tags"></i> Category</span>
                <span><i class="fas fa-chart-simple"></i> Type</span>
                <span><i class="fas fa-coins"></i> Amount</span>
                <span><i class="fas fa-cog"></i> Actions</span>
            </div>

            foreach (var t in Model)
            {
                string categoryName = "Uncategorized";
                string categoryIcon = "fas fa-tag";

                if (t.Category != null)
                {
                    categoryName = t.Category.Name ?? "Uncategorized";
                    categoryIcon = !string.IsNullOrEmpty(t.Category.Icon) ? t.Category.Icon : "fas fa-tag";
                }

                <div class="table-row">
                    <div>
                        <div class="t-desc">
                            @(string.IsNullOrEmpty(t.Description) ? "No description" : t.Description)
                        </div>
                        <div class="t-date">
                            <i class="fas fa-calendar-day"></i>
                            @t.Date.ToString("dd MMM yyyy")
                        </div>
                        @if (t.IsRecurring)
                        {
                            <div class="t-recur">
                                <i class="fas fa-sync-alt"></i>
                                @t.Frequency recurring
                            </div>
                        }
                    </div>
                    <div>
                        <span class="cat-pill">
                            <i class="@categoryIcon"></i>
                            @categoryName
                        </span>
                    </div>
                    <div>
                        <span class="type-badge @(t.Type == "Income" ? "type-income" : "type-expense")">
                            <i class="fas @(t.Type == "Income" ? "fa-arrow-trend-up" : "fa-arrow-trend-down")"></i>
                            @t.Type
                        </span>
                    </div>
                    <div class="t-amount @(t.Type == "Income" ? "amt-income" : "amt-expense")">
                        @(t.Type == "Income" ? "+" : "-") R @t.Amount.ToString("N2")
                    </div>
                    <div class="t-actions">
                        <a href="/Transaction/Edit/@t.Id" class="btn-edit-sm">
                            <i class="fas fa-pen"></i> Edit
                        </a>
                        @using (Html.BeginForm("Delete", "Transaction", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@t.Id" />
                            <button type="submit" class="btn-del-sm"
                                    onclick="return confirm('Are you sure you want to delete this transaction?')">
                                <i class="fas fa-trash-alt"></i> Del
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>