@{
    ViewBag.Title = "Account Created";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.HideSidebar = true;
}

<style>
    .success-container {
        max-width: 520px;
        margin: 80px auto;
        padding: 48px 40px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 24px;
        text-align: center;
        backdrop-filter: blur(10px);
        position: relative;
        overflow: hidden;
    }

        .success-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #6366f1, #8b5cf6, #10b981);
        }

    /* Animated checkmark */
    .check-wrap {
        width: 90px;
        height: 90px;
        background: rgba(16,185,129,0.12);
        border: 2px solid rgba(16,185,129,0.3);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        animation: popIn 0.5s cubic-bezier(0.2,0.9,0.4,1.2) both;
    }

        .check-wrap i {
            font-size: 38px;
            color: #10b981;
            animation: fadeIn 0.3s ease 0.3s both;
        }

    @@keyframes popIn {
        from {
            transform: scale(0);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: scale(0.5);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .success-title {
        font-size: 26px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 10px;
        animation: slideUp 0.5s ease 0.2s both;
    }

    .success-sub {
        font-size: 15px;
        color: rgba(255,255,255,0.5);
        line-height: 1.7;
        margin-bottom: 32px;
        animation: slideUp 0.5s ease 0.3s both;
    }

        .success-sub span {
            color: #10b981;
            font-weight: 600;
        }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Email notice */
    .email-notice {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        background: rgba(99,102,241,0.08);
        border: 1px solid rgba(99,102,241,0.2);
        border-radius: 12px;
        margin-bottom: 28px;
        text-align: left;
        animation: slideUp 0.5s ease 0.4s both;
    }

        .email-notice i {
            font-size: 22px;
            color: #a5b4fc;
            flex-shrink: 0;
        }

        .email-notice p {
            font-size: 13px;
            color: rgba(255,255,255,0.6);
            line-height: 1.5;
            margin: 0;
        }

        .email-notice strong {
            color: #a5b4fc;
        }

    /* Countdown */
    .countdown-wrap {
        margin-bottom: 28px;
        animation: slideUp 0.5s ease 0.5s both;
    }

    .countdown-label {
        font-size: 13px;
        color: rgba(255,255,255,0.4);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
    }

    .countdown-bar-bg {
        height: 6px;
        background: rgba(255,255,255,0.08);
        border-radius: 100px;
        overflow: hidden;
    }

    .countdown-bar {
        height: 100%;
        border-radius: 100px;
        background: linear-gradient(90deg, #6366f1, #10b981);
        width: 100%;
        transition: width 1s linear;
    }

    .countdown-num {
        font-size: 28px;
        font-weight: 800;
        color: #6366f1;
        margin-bottom: 6px;
    }

    /* Login button */
    .btn-login {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 36px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff;
        text-decoration: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 700;
        transition: all 0.2s;
        box-shadow: 0 4px 20px rgba(99,102,241,0.3);
        animation: slideUp 0.5s ease 0.6s both;
    }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 28px rgba(99,102,241,0.45);
            color: #fff;
            text-decoration: none;
        }

    /* Confetti particles */
    .confetti-wrap {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        overflow: hidden;
    }

    .confetti-piece {
        position: absolute;
        top: -10px;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        animation: confettiFall linear forwards;
    }

    @@keyframes confettiFall {
        0% {
            transform: translateY(0) rotate(0deg);
            opacity: 1;
        }

        100% {
            transform: translateY(500px) rotate(720deg);
            opacity: 0;
        }
    }
</style>

<div class="success-container" id="successCard">

    <!-- Confetti -->
    <div class="confetti-wrap" id="confettiWrap"></div>

    <!-- Check icon -->
    <div class="check-wrap">
        <i class="fas fa-check"></i>
    </div>

    <!-- Title -->
    <div class="success-title">
        Account created! 🎉
    </div>

    <p class="success-sub">
        Welcome to SmartSpend, <span>@ViewBag.RegisteredName</span>!<br />
        Your account has been set up and is ready to use.
    </p>

    <!-- Email notice -->
    <div class="email-notice">
        <i class="fas fa-envelope"></i>
        <p>
            <strong>Check your inbox!</strong> We've sent a welcome email
            with everything you need to get started.
        </p>
    </div>

    <!-- Countdown -->
    <div class="countdown-wrap">
        <div class="countdown-num" id="countNum">5</div>
        <div class="countdown-label">
            <i class="fas fa-clock"></i>
            Redirecting to login in <strong id="countText">5</strong> seconds...
        </div>
        <div class="countdown-bar-bg">
            <div class="countdown-bar" id="countBar"></div>
        </div>
    </div>

    <!-- Manual button -->
    <a href="@Url.Action("Login", "Account")" class="btn-login">
        <i class="fas fa-sign-in-alt"></i> Go to Login now
    </a>

</div>

@section scripts {
    <script>
    // Confetti
    var colors = ['#6366f1','#8b5cf6','#10b981','#f59e0b','#f87171','#34d399','#a5b4fc'];

    function spawnConfetti() {
        var wrap = document.getElementById('confettiWrap');
        for (var i = 0; i < 30; i++) {
            var piece = document.createElement('div');
            piece.className = 'confetti-piece';
            piece.style.left     = Math.random() * 100 + '%';
            piece.style.background = colors[Math.floor(Math.random() * colors.length)];
            piece.style.width    = (Math.random() * 8 + 5) + 'px';
            piece.style.height   = (Math.random() * 8 + 5) + 'px';
            piece.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
            piece.style.animationDuration  = (Math.random() * 2 + 1.5) + 's';
            piece.style.animationDelay     = (Math.random() * 1.5) + 's';
            wrap.appendChild(piece);
        }
    }

    spawnConfetti();

    // Countdown
    var total   = 5;
    var current = total;
    var bar     = document.getElementById('countBar');

    var timer = setInterval(function () {
        current--;

        document.getElementById('countNum').textContent  = current;
        document.getElementById('countText').textContent = current;

        var pct = (current / total) * 100;
        bar.style.width = pct + '%';

        if (current <= 0) {
            clearInterval(timer);
            window.location.href = '@Url.Action("Login", "Account")';
        }
    }, 1000);
    </script>
}