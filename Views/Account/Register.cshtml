@model SmartSpend.ViewModels.RegisterViewModel

@{
    ViewBag.Title = "Create Account"; // or "Create Account" for Register
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.HideSidebar = true; // Hide sidebar on login/register pages
}

<style>
    .register-container {
        max-width: 550px;
        margin: 60px auto;
        padding: 40px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 24px;
        backdrop-filter: blur(10px);
    }

    .register-header {
        text-align: center;
        margin-bottom: 30px;
    }

        .register-header h2 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .register-header p {
            color: rgba(255, 255, 255, 0.55);
            font-size: 14px;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.8);
        }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        color: #ffffff;
        font-size: 14px;
        transition: all 0.2s;
    }

        .form-control:focus {
            outline: none;
            border-color: #6366f1;
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

    .detect-box {
        display: none;
        margin-top: 10px;
        padding: 12px 16px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: 10px;
    }

    .detect-label {
        font-size: 11px;
        font-weight: 600;
        color: #10b981;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 8px;
    }

    .detect-values {
        display: flex;
        gap: 24px;
    }

    .detect-chip {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 14px;
        font-weight: 600;
        color: #ffffff;
    }

    .chip-icon {
        width: 28px;
        height: 28px;
        background: rgba(16, 185, 129, 0.2);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .btn-register {
        width: 100%;
        padding: 12px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        border: none;
        border-radius: 10px;
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
        }

    .login-link {
        text-align: center;
        margin-top: 20px;
        font-size: 14px;
        color: rgba(255, 255, 255, 0.55);
    }

        .login-link a {
            color: #6366f1;
            text-decoration: none;
            font-weight: 600;
        }

            .login-link a:hover {
                text-decoration: underline;
            }

    .text-danger {
        color: #f87171;
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }

    .validation-summary-errors ul {
        list-style: none;
        padding: 10px 14px;
        background: rgba(248, 113, 113, 0.1);
        border: 1px solid rgba(248, 113, 113, 0.3);
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .validation-summary-errors li {
        font-size: 13px;
        color: #f87171;
    }
</style>

<div class="register-container">
    <div class="register-header">
        <i class="fas fa-user-plus" style="font-size: 48px; color: #6366f1; margin-bottom: 15px;"></i>
        <h2>Create your account</h2>
        <p>Start tracking your finances in seconds</p>
    </div>

    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            <label><i class="fas fa-user"></i> First Name</label>
            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "Enter first name" })
            @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label><i class="fas fa-user"></i> Surname</label>
            @Html.TextBoxFor(m => m.Surname, new { @class = "form-control", placeholder = "Enter surname" })
            @Html.ValidationMessageFor(m => m.Surname, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label><i class="fas fa-id-card"></i> SA ID Number</label>
            @Html.TextBoxFor(m => m.IdNumber, new
            {
                @class = "form-control",
                placeholder = "13-digit ID number",
                id = "idNumber",
                maxlength = "13"
            })
            @Html.ValidationMessageFor(m => m.IdNumber, "", new { @class = "text-danger" })

            <div id="id-info" class="detect-box">
                <div class="detect-label"><i class="fas fa-robot"></i> Auto-detected from ID</div>
                <div class="detect-values">
                    <div class="detect-chip">
                        <span class="chip-icon"><i class="fas fa-birthday-cake"></i></span>
                        <span id="detected-age"></span>
                    </div>
                    <div class="detect-chip">
                        <span class="chip-icon"><i class="fas fa-venus-mars"></i></span>
                        <span id="detected-gender"></span>
                    </div>
                </div>
            </div>

            @Html.HiddenFor(m => m.Age, new { id = "hiddenAge" })
            @Html.HiddenFor(m => m.Gender, new { id = "hiddenGender" })
        </div>

        <div class="form-group">
            <label><i class="fas fa-envelope"></i> Email Address</label>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter email address", type = "email" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label><i class="fas fa-lock"></i> Password</label>
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Minimum 6 characters" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label><i class="fas fa-lock"></i> Confirm Password</label>
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Repeat your password" })
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn-register">
            <i class="fas fa-user-check"></i> Create Account →
        </button>

        <div class="login-link">
            Already have an account? <a href="@Url.Action("Login", "Account")">
                <i class="fas fa-sign-in-alt"></i> Sign in here
            </a>
        </div>
    }
</div>

<script>
    document.getElementById('idNumber').addEventListener('input', function () {
        var id = this.value.trim();
        var infoBox = document.getElementById('id-info');
        var hiddenAge = document.getElementById('hiddenAge');
        var hiddenGender = document.getElementById('hiddenGender');

        if (id.length !== 13 || isNaN(id)) {
            infoBox.style.display = 'none';
            hiddenAge.value = '';
            hiddenGender.value = '';
            return;
        }

        var yearStr = id.substring(0, 2);
        var monthStr = id.substring(2, 4);
        var dayStr = id.substring(4, 6);

        var fullYear = parseInt(yearStr) > 25
            ? 1900 + parseInt(yearStr)
            : 2000 + parseInt(yearStr);

        var dob = new Date(fullYear, parseInt(monthStr) - 1, parseInt(dayStr));
        var today = new Date();
        var age = today.getFullYear() - dob.getFullYear();

        var hasBirthdayPassed = (
            today.getMonth() > dob.getMonth() ||
            (today.getMonth() === dob.getMonth() && today.getDate() >= dob.getDate())
        );
        if (!hasBirthdayPassed) age--;

        var genderDigits = parseInt(id.substring(6, 10));
        var gender = genderDigits >= 5000 ? 'Male' : 'Female';

        document.getElementById('detected-age').textContent = age + ' years old';
        document.getElementById('detected-gender').textContent = gender;
        infoBox.style.display = 'block';

        hiddenAge.value = age;
        hiddenGender.value = gender;
    });
</script>