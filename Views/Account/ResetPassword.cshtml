@model SmartSpend.ViewModels.ResetPasswordViewModel

@{
    ViewBag.Title = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.HideSidebar = true;
}

<style>
    .auth-container {
        max-width: 460px;
        margin: 60px auto;
        padding: 40px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 24px;
        backdrop-filter: blur(10px);
        position: relative;
        overflow: hidden;
    }

        .auth-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #6366f1, #8b5cf6, #10b981);
        }

    .auth-header {
        text-align: center;
        margin-bottom: 28px;
    }

        .auth-header .icon-wrap {
            width: 72px;
            height: 72px;
            border-radius: 20px;
            background: rgba(16,185,129,0.12);
            border: 1px solid rgba(16,185,129,0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            margin: 0 auto 18px;
        }

        .auth-header h2 {
            font-size: 24px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 8px;
        }

        .auth-header p {
            font-size: 14px;
            color: rgba(255,255,255,0.45);
            line-height: 1.6;
        }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        font-weight: 600;
        color: rgba(255,255,255,0.55);
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px;
        color: #fff;
        font-size: 15px;
        font-family: inherit;
        outline: none;
        transition: all 0.2s;
    }

        .form-control::placeholder {
            color: rgba(255,255,255,0.25);
        }

        .form-control:focus {
            border-color: #6366f1;
            background: rgba(99,102,241,0.08);
            box-shadow: 0 0 0 3px rgba(99,102,241,0.12);
        }

    /* Password strength bar */
    .strength-wrap {
        margin-top: 8px;
    }

    .strength-bar-bg {
        height: 4px;
        background: rgba(255,255,255,0.08);
        border-radius: 100px;
        overflow: hidden;
        margin-bottom: 5px;
    }

    .strength-bar {
        height: 100%;
        border-radius: 100px;
        transition: all 0.3s;
        width: 0%;
    }

    .strength-label {
        font-size: 11px;
        color: rgba(255,255,255,0.35);
    }

    .text-danger {
        color: #f87171;
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }

    .btn-submit {
        width: 100%;
        padding: 13px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s;
        box-shadow: 0 4px 15px rgba(99,102,241,0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-submit:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    .back-link {
        text-align: center;
        margin-top: 20px;
        font-size: 14px;
        color: rgba(255,255,255,0.4);
    }

        .back-link a {
            color: #6366f1;
            text-decoration: none;
            font-weight: 600;
        }

            .back-link a:hover {
                text-decoration: underline;
            }

    /* Requirements checklist */
    .requirements {
        padding: 14px 16px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 10px;
        margin-top: 10px;
    }

    .req-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: rgba(255,255,255,0.4);
        margin-bottom: 6px;
        transition: color 0.2s;
    }

        .req-item:last-child {
            margin-bottom: 0;
        }

        .req-item.met {
            color: #34d399;
        }

        .req-item i {
            width: 14px;
        }
</style>

<div class="auth-container">
    <div class="auth-header">
        <div class="icon-wrap">🔑</div>
        <h2>Create new password</h2>
        <p>Enter a strong new password for your SmartSpend account.</p>
    </div>

    @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(m => m.Token)

        <div class="form-group">
            <label><i class="fas fa-lock"></i> New Password</label>
            @Html.PasswordFor(m => m.NewPassword, new
            {
                @class = "form-control",
                placeholder = "Minimum 6 characters",
                id = "newPassword",
                oninput = "checkStrength(this.value)"
            })
            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })

            <div class="strength-wrap">
                <div class="strength-bar-bg">
                    <div class="strength-bar" id="strengthBar"></div>
                </div>
                <div class="strength-label" id="strengthLabel">Enter a password</div>
            </div>

            <div class="requirements" id="requirements">
                <div class="req-item" id="req-length">
                    <i class="fas fa-circle"></i> At least 6 characters
                </div>
                <div class="req-item" id="req-upper">
                    <i class="fas fa-circle"></i> Contains uppercase letter
                </div>
                <div class="req-item" id="req-number">
                    <i class="fas fa-circle"></i> Contains a number
                </div>
                <div class="req-item" id="req-special">
                    <i class="fas fa-circle"></i> Contains special character
                </div>
            </div>
        </div>

        <div class="form-group">
            <label><i class="fas fa-lock"></i> Confirm New Password</label>
            @Html.PasswordFor(m => m.ConfirmPassword, new
            {
                @class = "form-control",
                placeholder = "Repeat new password",
                id = "confirmPassword",
                oninput = "checkMatch()"
            })
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            <span id="matchMsg" style="font-size:12px; margin-top:5px; display:none;"></span>
        </div>

        <button type="submit" class="btn-submit">
            <i class="fas fa-save"></i> Reset Password
        </button>
    }

    <div class="back-link">
        <a href="@Url.Action("Login", "Account")">
            <i class="fas fa-arrow-left"></i> Back to Login
        </a>
    </div>
</div>

@section scripts {
    <script>function checkStrength(val) {
        var bar   = document.getElementById('strengthBar');
        var label = document.getElementById('strengthLabel');

        var hasLength  = val.length >= 6;
        var hasUpper   = /[A-Z]/.test(val);
        var hasNumber  = /[0-9]/.test(val);
        var hasSpecial = /[^A-Za-z0-9]/.test(val);

        // Update requirement items
        toggleReq('req-length',  hasLength);
        toggleReq('req-upper',   hasUpper);
        toggleReq('req-number',  hasNumber);
        toggleReq('req-special', hasSpecial);

        var score = [hasLength, hasUpper, hasNumber, hasSpecial]
                    .filter(Boolean).length;

        var configs = [
            { width: '0%',   color: 'transparent',                    text: 'Enter a password' },
            { width: '25%',  color: '#f87171',                        text: 'Weak' },
            { width: '50%',  color: '#f59e0b',                        text: 'Fair' },
            { width: '75%',  color: '#6366f1',                        text: 'Good' },
            { width: '100%', color: '#10b981',                        text: 'Strong ✓' },
        ];

        var cfg = val.length === 0 ? configs[0] : configs[score];
        bar.style.width      = cfg.width;
        bar.style.background = cfg.color;
        label.textContent    = cfg.text;
        label.style.color    = cfg.color === 'transparent'
                               ? 'rgba(255,255,255,0.35)'
                               : cfg.color;
    }

    function toggleReq(id, met) {
        var el = document.getElementById(id);
        el.classList.toggle('met', met);
        el.querySelector('i').className = met
            ? 'fas fa-check-circle'
            : 'fas fa-circle';
    }

    function checkMatch() {
        var p1  = document.getElementById('newPassword').value;
        var p2  = document.getElementById('confirmPassword').value;
        var msg = document.getElementById('matchMsg');

        if (p2.length === 0) { msg.style.display = 'none'; return; }

        msg.style.display = 'block';

        if (p1 === p2) {
            msg.textContent = '✓ Passwords match';
            msg.style.color = '#34d399';
        } else {
            msg.textContent = '✗ Passwords do not match';
            msg.style.color = '#f87171';
        }
    }</script>
}