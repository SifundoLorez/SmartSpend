@using SmartSpend.Models
@{
    ViewBag.Title = "Notifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.HideSidebar = false;
    var notifications = ViewBag.Notifications as System.Collections.Generic.List<Notification>;
}

<style>
    .notif-main {
        padding: 36px 40px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
    }

        .page-header h1 {
            font-size: 28px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .page-header p {
            font-size: 14px;
            color: rgba(255,255,255,0.45);
            margin-top: 6px;
        }

    .btn-clear-all {
        padding: 10px 20px;
        border-radius: 10px;
        background: rgba(248,113,113,0.1);
        color: #f87171;
        border: 1px solid rgba(248,113,113,0.2);
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-clear-all:hover {
            background: rgba(248,113,113,0.2);
        }

    .notif-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: 800px;
    }

    .notif-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 16px;
        padding: 18px 20px;
        display: flex;
        align-items: flex-start;
        gap: 16px;
        transition: all 0.2s;
        position: relative;
    }

        .notif-card:hover {
            background: rgba(255,255,255,0.06);
        }

        .notif-card.unread {
            border-left: 4px solid #6366f1;
        }

        .notif-card.type-danger {
            border-left-color: #f87171;
        }

        .notif-card.type-warning {
            border-left-color: #fbbf24;
        }

        .notif-card.type-success {
            border-left-color: #10b981;
        }

        .notif-card.type-info {
            border-left-color: #6366f1;
        }

    .notif-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .icon-danger {
        background: rgba(248,113,113,0.12);
    }

    .icon-warning {
        background: rgba(245,158,11,0.12);
    }

    .icon-success {
        background: rgba(16,185,129,0.12);
    }

    .icon-info {
        background: rgba(99,102,241,0.12);
    }

    .notif-body {
        flex: 1;
    }

    .notif-title {
        font-size: 15px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 5px;
    }

    .notif-message {
        font-size: 13px;
        color: rgba(255,255,255,0.55);
        line-height: 1.5;
    }

    .notif-time {
        font-size: 11px;
        color: rgba(255,255,255,0.3);
        margin-top: 8px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .btn-del-notif {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: transparent;
        border: 1px solid rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.3);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        transition: all 0.2s;
        flex-shrink: 0;
    }

        .btn-del-notif:hover {
            background: rgba(248,113,113,0.1);
            color: #f87171;
            border-color: rgba(248,113,113,0.2);
        }

    .empty-state {
        text-align: center;
        padding: 100px 40px;
        color: rgba(255,255,255,0.3);
    }

        .empty-state i {
            font-size: 56px;
            margin-bottom: 16px;
            display: block;
            opacity: 0.4;
        }

        .empty-state p {
            font-size: 16px;
        }

        .empty-state small {
            font-size: 13px;
            color: rgba(255,255,255,0.2);
        }

    @@media (max-width: 768px) {
        .notif-main {
            padding: 20px 16px;
        }
    }
</style>

<div class="notif-main">
    <div class="page-header">
        <div>
            <h1>
                <i class="fas fa-bell" style="color:#6366f1;"></i>
                Notifications
            </h1>
            <p>@(notifications?.Count ?? 0) notification(s)</p>
        </div>
        @if (notifications != null && notifications.Any())
        {
            using (Html.BeginForm("ClearAll", "Notification", FormMethod.Post,
                    new { style = "display:inline;" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-clear-all"
                        onclick="return confirm('Clear all notifications?')">
                    <i class="fas fa-trash-alt"></i> Clear All
                </button>
            }
        }
    </div>

    <div class="notif-list">
        @if (notifications == null || !notifications.Any())
        {
            <div class="empty-state">
                <i class="fas fa-bell-slash"></i>
                <p>No notifications</p>
                <small>You're all caught up!</small>
            </div>
        }
        else
        {
            foreach (var n in notifications)
            {
                string iconClass = n.Type == "danger" ? "icon-danger"
                                 : n.Type == "warning" ? "icon-warning"
                                 : n.Type == "success" ? "icon-success"
                                 : "icon-info";

                <div class="notif-card type-@n.Type @(!n.IsRead ? "unread" : "")">
                    <div class="notif-icon @iconClass">@n.Icon</div>
                    <div class="notif-body">
                        <div class="notif-title">@n.Title</div>
                        <div class="notif-message">@n.Message</div>
                        <div class="notif-time">
                            <i class="fas fa-clock"></i>
                            @n.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                        </div>
                    </div>
                    @using (Html.BeginForm("Delete", "Notification", FormMethod.Post,
                            new { style = "display:inline;" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@n.Id" />
                        <button type="submit" class="btn-del-notif" title="Dismiss">
                            <i class="fas fa-times"></i>
                        </button>
                    }
                </div>
            }
        }
    </div>
</div>